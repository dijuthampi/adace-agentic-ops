# AdAce Agentic Ops - Environment Configuration

# Database URLs
# For Docker internal communication:
# ADACE_MYSQL_URL=mysql+aiomysql://adace_user:adace_pass@adace_mysql:3306/adace_sandbox
# AGENT_PG_URL=postgresql+asyncpg://agent_user:agent_pass@agent_pg:5432/agent_state

# For Local Host communication (e.g. running uvicorn directly outside Docker):
ADACE_MYSQL_URL=mysql+aiomysql://adace_user:adace_pass@localhost:3307/adace_sandbox
AGENT_PG_URL=postgresql+asyncpg://agent_user:agent_pass@localhost:5433/agent_state

# AI Provider Configuration
AI_PROVIDER=mock
GEMINI_API_KEY=your_gemini_api_key_here

# Application Configuration
APP_NAME=AdAce Agentic Ops
APP_ENV=development
DEBUG=True
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
